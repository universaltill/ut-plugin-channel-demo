{
  "id": "com.universaltill.channel-demo",
  "name": "Demo channel",
  "version": "0.1.1",
  "description": "A pretend web shop that lets you try Universal Till sales channels without any real shop account: connect it, import its products, receive its orders and send stock, fulfilment and cancels back. Every product, order and customer is invented. It runs only in the Universal Till cloud and is offered to test shops.",
  "author": "Universal Till",
  "website": "https://universaltill.com",
  "canonical_type": "channel",
  "runtime": "wasm",
  "entrypoint": "./bin/plugin.wasm",
  "device_arch": "any",
  "hosts": ["cloud"],
  "channel_contract": 1,
  "permissions": ["net:{account}"],
  "locales": ["en-US"],
  "channel": {
    "kind": "webshop",
    "account": "^[a-z0-9-]+\\.demo-shop\\.example$",
    "account_suffix": ".demo-shop.example",
    "auth": {
      "grants": ["code"],
      "authorize_url": "https://{account}/oauth/authorize",
      "token_url": "https://{account}/oauth/token",
      "scopes": ["products", "inventory", "orders"],
      "pkce": true,
      "refresh": true,
      "callback_verify": {"param": "hmac", "alg": "hmac-sha256", "encoding": "hex", "canonical": "sorted-query-without-param"},
      "inject": {"header": "X-Demo-Token"}
    },
    "capabilities": {
      "items": "pull", "variants": "pull", "categories": "pull", "images": "pull",
      "stock": "both", "orders": "pull", "fulfilment": "push", "cancel": "push", "compare_at": "pull"
    },
    "limits": {"max_options": 3, "max_variants": 100},
    "webhooks": {
      "topics": ["orders/create", "orders/updated", "app/uninstalled", "customers/redact", "shop/redact", "customers/data_request"],
      "verify": {"header": "X-Demo-Hmac", "alg": "hmac-sha256", "encoding": "base64"}
    },
    "schedules": [{"event": "reconcile", "every_s": 900, "jitter_s": 60}]
  }
}
